<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="boilerplate"
        Arguments=""
        InstallLocation="C:\Program Files\Your Name\Boilerplate">
    </Installer>
    <PackageInformation
        PackageName="Boilerplate"
        PackageDisplayName="Boilerplate"
        PublisherName="CN=Your Name"
        PublisherDisplayName="Your Name"
        Version="0.1.0.0"
        PackageDescription="Wails + Vue 3 + Go foundation.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wails.boilerplate"
                Description="Wails + Vue 3 + Go foundation."
                DisplayName="Boilerplate"
                ExecutableName="boilerplate"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Boilerplate</DisplayName>
            <PublisherDisplayName>Your Name</PublisherDisplayName>
            <Description>Wails + Vue 3 + Go foundation.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="boilerplate.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
