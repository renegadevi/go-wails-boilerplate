# Copy this file to build/dist.env and fill in the values you have.
# build/dist.env is gitignored. ./scripts/build.sh build does not read it.
# ./scripts/build.sh build --dist does. Variables already set in the environment win.

# Developer ID Application certificate name from:
#   security find-identity -v -p codesigning
# If this is unset and the keychain has exactly one Developer ID Application
# certificate, that certificate is used.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Name passed to: xcrun notarytool store-credentials "your-notary-profile"
# APPLE_NOTARY_KEYCHAIN_PROFILE="your-notary-profile"

# Authenticode certificate. A self-signed file still trips SmartScreen.
# Windows: C:\Users\you\certificate.pfx
# Mac or Linux: /path/to/certificate.pfx
# Keep the .pfx outside the repository.
# WINDOWS_CERT_PATH="/path/to/certificate.pfx"
# WINDOWS_CERT_PASSWORD=""
# WINDOWS_TIMESTAMP_URL="http://timestamp.digicert.com"

# Optional. Unsigned deb and rpm packages still install.
# LINUX_PGP_KEY="/path/to/signing-key.asc"
# LINUX_PGP_PASSWORD=""
