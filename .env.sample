# App log (prezerolog). The Wails watcher level is dev_mode.log_level in build/config.yml.
LOG_DIR=logs
LOG_NAME=boilerplate
LOG_ENV=development
LOG_FILE=true
LOG_CONSOLE=true
LOG_CONSOLE_LEVEL=debug
LOG_FILE_LEVEL=debug
LOG_CONSOLE_OUTPUT=full
LOG_SAMPLING_N=1
LOG_ROTATE_MAX_SIZE=100
LOG_ROTATE_MAX_BACKUPS=7
